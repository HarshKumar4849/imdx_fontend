# Cygnus Platform API base URL (Spring Boot platform service: onboarding, auth, admin, compute)
# Example: http://localhost:8080
VITE_PLATFORM_BASE=

# Cygnus Participant Agent API base URL (Spring Boot agent service: datasets, catalog, subscriptions, transfers, billing)
# Leave empty if served from the same origin or proxied at /api/v1
VITE_AGENT_BASE=

# Optional Cloudflare Turnstile site key for public onboarding & application tracking
VITE_TURNSTILE_SITE_KEY=

# Optional single-origin gateway fallback (used if VITE_PLATFORM_BASE / VITE_AGENT_BASE are unset)
VITE_API_BASE_URL=
